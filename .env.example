PLEX_TOKEN=
# For Docker on Linux, the setup script uses http://host.docker.internal:32400.
# Replace it if Plex is on another host.
PLEX_URL=http://host.docker.internal:32400
PLEX_MACHINE_IDENTIFIER=
PLEX_CLIENT_IDENTIFIER=watchmatch-web
# Keep false during initial local setup; set true before allowing remote access.
AUTH_REQUIRED=false
SYSTEM_OWNER_PLEX_ID=
SYSTEM_RECOVERY_CODE=
PUBLIC_URL=http://localhost:8080
POSTGRES_DB=watchmatch
POSTGRES_USER=watchmatch
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Local default: ./postgres-data
POSTGRES_DATA_PATH=./postgres-data
